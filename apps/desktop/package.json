{
  "name": "@impeller-reliability/desktop",
  "version": "0.1.0",
  "description": "Калькулятор показателей надёжности рабочих колёс вентиляторов",
  "author": {
    "name": "ООО «РВЗ»"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:preview": "electron-vite --rendererOnly",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "electron-vite build",
    "package:win-unpacked": "electron-builder --win dir --x64",
    "package:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@impeller-reliability/application": "workspace:*",
    "@impeller-reliability/contracts": "workspace:*",
    "@mantine/core": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  }
}
