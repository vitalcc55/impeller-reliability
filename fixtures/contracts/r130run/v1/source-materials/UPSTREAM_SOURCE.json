  "seed": {
    "source": "tests/helpers/m9a_run_packages.py persisted synthetic RBD run and existing production protocol workspace/release APIs; explicit distinct synthetic source Specimen IDs avoid pre-existing bindings in combined smoke cases",
    "provenanceAdjustment": "Only in an isolated git archive, helper app_version/build_id/git_commit were changed from m9a placeholders to the recorded producer version, synthetic build label and exact commit before bundle creation. No producer application code was changed.",
    "buildId": "source-materials-synthetic-9d92abb",
    "media": "Qt QImage/QPainter create valid JPEG/PNG explicitly labelled SYNTHETIC SOFTWARE TEST; production protocol service renders PDF from saved synthetic facts and a prominently labelled synthetic laboratory/conclusion.",
    "savedRevisions": "One saved run is exported before protocol release (export 1), after saved release revision 1 (export 2), and after changed saved release revision 2 (export 3). Another saved run is exported diagnostic_partial after deleting only its managed photo bytes inside the isolated seed.",
    "hardwareAcceptance": false,
    "limitations": "All facts, photographs and documents are synthetic software-test data, not a real laboratory test, validated laboratory conclusion or signature. Qt PDF successfully loaded both produced PDFs; byte/header checks do not prove laboratory content."
